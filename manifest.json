{
  "manifest_version": 3,
  "name": "GR360 Listing Importer",
  "version": "1.0.0",
  "description": "Import property listings directly into your CRM with one click.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.property24.com/*",
    "https://www.privateproperty.co.za/*",
    "https://www.pamgolding.co.za/*",
    "https://www.seeff.com/*",
    "https://crm.gardenroute360.co.za/*",
    "https://*.lovable.app/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.property24.com/*",
        "https://www.privateproperty.co.za/*",
        "https://www.pamgolding.co.za/*",
        "https://www.seeff.com/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
